# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://sig-tel.com

# ---------- Database (PostgreSQL) ----------
# When set, the app uses PostgreSQL; otherwise a local JSON store in .data/.
# Works with Neon, Supabase, RDS or any managed Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/sigtel?sslmode=require

# ---------- Authentication ----------
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@sig-tel.com
ADMIN_PASSWORD=SigTel@2010

# ---------- Enquiry email notifications ----------
# RESEND_API_KEY=re_xxxxxxxx
# ENQUIRY_NOTIFICATION_EMAIL=sigtel2011@gmail.com
# ENQUIRY_FROM_EMAIL=SIG-TEL Website <website@sig-tel.com>

# ---------- Spam protection (optional) ----------
# TURNSTILE_SECRET_KEY=

# ---------- Analytics (optional) ----------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sig-tel.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---------- Media (optional) ----------
# Cloudinary is supported by next.config.ts remotePatterns if you move media there.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
